---
import '../../styles/global.css';

import { motion } from 'framer-motion';

const  {header, description, page, id  }= Astro.props;


---

<div class="flex justify-center  w-full">
    <a href={page} class="block w-2/3">
      <motion.div 
        className="relative w-full h-[700px] flex inset-shadow-black shadow-2xl text-center m-10 rounded-3xl"
        client:load
      >
        <div class="relative w-full flex flex-col justify-start bg-[#EEE] rounded-3xl">
            <div class = 'text-box'>
                <h1 class='text-3xl'>{header}</h1>
                <p class='text-2xl'>{description}</p>
            </div>
        </div>
      </motion.div>
    </a>
</div>
