---
import '../styles/global.css';

import {Instagram, Facebook, Twitter} from 'lucide-react';
---

<footer class='w-full h-auto bg-[#f5f5f5] flex  flex-col text-center md:text-left md:flex-row justify-between p-5'>
  <!--Little header--> 
  <div class='flex flex-col p-5'>
    <h1 class='text-xl mb-2'>Fund the Future</h1>
    <h2 class='font-inter font-thin'>Something Something Somethign</h2>
  </div>

  <!--Chapters-->

  <div class='flex flex-col p-5'>
    <h1 class='text-lg mb-2'>Chapters</h1>

    <a href='/chapters/cherry-creek' class='font-inter font-thin transition duration-300 ease-in-out hover:text-green-500'>Cherry Creek</a>
    <a href='/chapters/grandview' class='font-inter font-thin transition duration-300 ease-in-out hover:text-green-500'>Grandview</a>
    <a href='/chapters/' class='font-inter font-thin transition duration-300 ease-in-out hover:text-green-500 '>More</a>
    
    
  </div>

  <!--Funding Ops-->

  <div class='flex flex-col p-5'>
    <h1 class='text-lg mb-2'>Funding</h1>
    <a href='/funding/apply' class='font-inter font-thin transition duration-300 ease-in-out hover:text-green-500'>Grant Application</a>
    <a href='/funding/donate' class='font-inter font-thin transition duration-300 ease-in-out hover:text-green-500'>Donations</a>

  </div>

  <!--Socials-->
  <div class='flex flex-col p-5'>
    <div>
      <h1 class='text-lg mb-2'>Get in Touch</h1>
      <h2 class='w-[200px] mx-auto font-inter font-thin'>Questions or feedback? We'd like to hear from you!</h2>
    </div>

    <div class='flex mt-5 justify-around'>
      <a class= 'transition duration-300 ease-in-out hover:text-green-500' href='/'><Instagram size={24}/></a>
      <a class= 'transition duration-300 ease-in-out hover:text-green-500' href='/'><Facebook size={24}/></a>
      <a class= 'transition duration-300 ease-in-out hover:text-green-500' href='/'><Twitter size={24}/></a>    
    </div>
  </div>
</footer>

<style>

h{
  margin-bottom:10px;
}

</style>
