---
import '../styles/global.css';
import Nav from './Nav.astro';

import {FileUser, HandCoins} from 'lucide-react';

import NavigationMenu from '../components/ui/navigation-menu.tsx';

import { motion } from 'framer-motion';
---
<div class='absolute w-full h-auto'>
  <header class='sticky min-w-[350px] h-[100px] bg-[#f5f5f5] z-[1000] top-0 flex justify-between  items-center p-5'>
    <Nav ></Nav>

    <div class='absolute w-1/3 h-full right-0 flex ml-auto justify-end pr-3 sm:pr-10  gap-5 md:gap-6'>
      <motion.a 
        initial={{scale:1, backgroundColor:'#7bf1a8', color:'white', opacity:0, y:-10}}
        animate={{opacity:1, y:0, transition:{delay:1, duration:0.3}}}
        transition={{duration:0.3}}

        whileHover={{scale:0.97, backgroundColor:'#50c982'}}
        whileTap={{scale:0.93}}

        href='/funding/apply' 

        className='w-[50px] lg:w-[100px] h-[50px]  my-auto border-solid rounded-md text-green-500 flex justify-center items-center'
        client:load
      >
        <div class='flex gap-1 items-center'>
          <FileUser size={36}/>
          <h1 class='hidden lg:block' >Apply</h1>
        </div>
      

      </motion.a>
      
      <motion.a 
        initial={{scale:1, backgroundColor:'#3d4240', color:'white', opacity:0, y:-10}}
        animate={{opacity:1, y:0, transition:{delay:1.25, duration:0.3}}}
        transition={{duration:0.3}}

        whileHover={{scale:0.97, backgroundColor:'#232725'}}
        whileTap={{scale:0.93}}

        href='/funding/donate' 

        className='w-[50px] lg:w-[110px] h-[50px]  my-auto border-solid rounded-md text-green-500 flex justify-center items-center'
        client:load
      >
        <div class='flex gap-1 items-center'>
          <HandCoins size={36}/>
          <h1 class='hidden lg:block' >Donate</h1>
        </div>
      

      </motion.a>


    </div>
  </header>
</div>
