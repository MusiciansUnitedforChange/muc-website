---
import '../styles/global.css';
import Nav from './Nav.astro';

import { motion } from 'framer-motion';
---
<div class='absolute w-full h-auto'>
  <header class='sticky h-[100px] bg-[#EEE] z-[1000] top-0 flex justify-center'>
    <Nav></Nav>

    <div class='absolute w-1/3 h-full right-0 flex ml-auto w-1/5 justify-center gap-5'>
      <motion.a 
        initial={{backgroundColor:'white', color:'#7bf1a8'}}
        whileHover={{backgroundColor:'#7bf1a8', color:'white'}}

        href='/apply' className='w-1/3 border-solid border-2 border-green-500 rounded-3xl text-green-500 flex justify-center items-center'
        client:load
      >Apply</motion.a>
      <a class='w-1/3 border-solid border-2 rounded-3xl border-2 border-black rounded-3xl flex justify-center items-center '>Donate</a>

    </div>
  </header>
</div>
