---
import '../styles/global.css';
import Nav from './Nav.astro';

import { motion } from 'framer-motion';
---

<header class='sticky h-1/2 bg-[#EEE] z-[1000] top-0 flex justify-center'>
  <Nav></Nav>

  <div class='absolute w-1/3 h-full right-0 flex ml-auto w-1/5 justify-center gap-5'>
    <button class='w-1/3 border-solid border-2 border-green-500 rounded-3xl text-green-500'>Apply</button>
    <button class='w-1/3 border-solid border-2 rounded-3xl'>Donate</button>

  </div>
</header>
