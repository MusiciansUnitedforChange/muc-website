---
import '../styles/global.css';
import {motion} from 'framer-motion';

const { name, position, image }  = Astro.props;
---

<motion.div
  initial={{opacity:0}},
  animate={{opacity:1}},
  transition={{duration:.5,ease:'smooth'}}
  
  className=`w-1/4 aspect-[5/6] bg-[#EEE] flex flex-col inset-shadow-black shadow-2xl text-center m-10 rounded-3xl`

  client:load
>
  <img class=' w-full h-3/4 rounded-t-2xl'></img>
  <div class='w-full h-1/4 flex flex-col justify-center '>
    <h1 class='text-4xl'>{name}</h1>
    <h2 class='text-3xl'>{position}</h2>
  </div>
</motion.div>
