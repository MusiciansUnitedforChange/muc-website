---
import '../styles/global.css';
import {motion} from 'framer-motion';

const { name, position, grade }  = Astro.props;


const gradeMap={
  9: "Freshman",
  10: "Sophomore",
  11: "Junior",
  12: "Senior",

}
---

<motion.div
  initial={{opacity:0}}
  animate={{opacity:1}}
  transition={{duration:.3,ease:'smooth'}}
  
  className=`w-1/4 aspect-[5/6] flex flex-col shadow-sombra shadow-2xl bg-white text-center m-10 rounded-3xl`

  client:load
>
  <img class=' w-full h-3/4 rounded-t-2xl'></img>
  <div class='w-full h-1/4 flex flex-col justify-center items-center'>
    <h1 class='w-auto text-4xl border-b-4 border-b-green-300'>{name}</h1>
    <h2 class='text-3xl'>{position}</h2>
  </div>
</motion.div>
