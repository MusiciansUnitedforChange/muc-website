---
import '../styles/global.css';

import { motion } from 'framer-motion';
import { House, Users, Send } from 'lucide-react';

const {pathname} =Astro.url;


---


<nav class='w-1/2 overflow-y-hidden'>
<h1></h1>
  <ul class='flex p-5 text-2xl gap-10 justify-center w-full h-auto list-none'>
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{duration:.75, type:'spring', bounce:0}}

      className=`border-b-4 ${pathname === '/' ? 'border-b-green-300' : 'border-b-sombra'}`
      client:load
    ><a href='/'>

        <div class='flex flex-col items-center'>
          <House size={30}/>
          <h2>Home</h2>
        </div>

    </a></motion.li>
    
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{delay:.25, duration:.75, type:'spring', bounce:0}}

      className=`border-b-4 ${pathname === '/chapters' ? 'border-b-green-300' : 'border-b-sombra'}`
      client:load
    ><a href='/chapters'>

        <div class='flex flex-col items-center'>
          <Users size={30}/>
          <h2>Chapters</h2>
        </div>

    </a></motion.li>
    
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{delay:.5, duration:.75, type:'spring', bounce:0}}

      className=`border-b-4 ${pathname === '/contact' ? 'border-b-green-300' : 'border-b-sombra'}`
      client:load
    ><a href='/'>

        <div class='flex flex-col items-center'>
          <Send size={30}/>
          <h2>Contact</h2>
        </div>

    </a></motion.li>
    
    
   
      
  </ul>
</nav>

