---
import '../styles/global.css';

import { motion } from 'framer-motion';
import { House, Users, Send } from 'lucide-react';

const {pathname} =Astro.url;


---


<nav class=' min-w-[100px] w-3/4 overflow-y-hidden'>
  <ul class='flex font-inter text-2xl gap-5 sm:gap-8  md:gap-10 lg:gap-20 justify-start md:justify-center items-center  w-full h-full list-none'>
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{duration:.3, type:'spring', bounce:0}}

      className=`min-w-[50px] sm:w-[55px] md:w-[65px] lg:w-[75px] aspect-square border-b-4 ${pathname === '/' ? 'border-b-green-300 font-bold' : 'border-b-sombra'}`
      client:load
    ><a href='/'>

        <div class='w-full h-full flex flex-col items-center justify-around '>
          <House size={36} />
          <h2 class=' hidden md:block text-xl lg:text-2xl'>Home</h2>
        </div>
      </a>
    
    </motion.li>

    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0, transition:{delay:0.25, duration:0.3}}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{ duration:.5, type:'spring', bounce:0}}

      className=`min-w-[50px] sm:w-[55px] md:w-[65px] lg:w-[75px] aspect-square border-b-4 ${pathname === '/chapters' ? 'border-b-green-300 font-bold' : 'border-b-sombra'}`
      client:load
    ><a href='/chapters'>

        <div class='w-full h-full flex flex-col items-center justify-around '>
          <Users size={36} />
          <h2 class=' hidden md:block text-xl lg:text-2xl'>Chapters</h2>
        </div>
      </a>
    
    </motion.li> 
 

    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0, transition:{delay:0.5, duration:.3}}}

      whileHover={{
        color: "#86efac",
        transition:{duration:.2}
    
      }}

      whileTap={{
        borderBottomColor: "#86efac",
        scale:0.97,
        transition:{duration:.1}
    
      }}


      transition={{ duration:.75, type:'spring', bounce:0}}

      className=`min w-[50px] sm:w-[55px] md:w-[65px] lg:w-[75px] aspect-square border-b-4 ${pathname === '/contact' ? 'border-b-green-300 font-bold' : 'border-b-sombra'}`
      client:load
    ><a href='/contact'>

        <div class='w-full h-full flex flex-col items-center justify-around '>
          <Send size={36} />
          <h2 class=' hidden md:block text-xl lg:text-2xl'>Contact</h2>
        </div>
      </a>
    
    </motion.li> 
 
        
  </ul>
</nav>

