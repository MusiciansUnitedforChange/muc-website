---
import '../styles/global.css';

import { motion } from 'framer-motion';
import { House, Users, Send } from 'lucide-react';

---

<nav class='w-1/2'>
  <ul class='flex p-5 text-2xl gap-10 justify-center w-full h-auto list-none'>
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}
      transition={{duration:.75, type:'spring', bounce:0}}
      className=''
      client:load
    ><a href='/'>

        <div class='flex flex-col items-center'>
          <House size={30}/>
          <h2>Home</h2>
        </div>

    </a></motion.li>
    
   
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}
      transition={{duration:.75, delay:.25, type:'spring', bounce:0 }}
      className=''
      client:load
    ><a href='/chapters'>

       
        <div class='flex flex-col items-center'>
          <Users size={30}/>
          <h2>Chapters</h2>
        </div>

 

      </a></motion.li>

   
    <motion.li
      initial={{opacity:0, y:-10}}
      animate={{opacity:1, y:0}}
      transition={{duration:.75, delay:.5, type:'spring', bounce:0 }}
      className=''
      client:load
    ><a href='/'>

       
        <div class='flex flex-col items-center'>
          <Send size={30}/>
          <h2>Contact</h2>
        </div>

 

      </a></motion.li>

   
 
   
  </ul>
</nav>
