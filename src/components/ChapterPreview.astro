---
import '../styles/global.css';

import { motion } from 'framer-motion';

const { name, location, image, page } = Astro.props;
---

<a href={page} class='block w-1/5'>
  <motion.div 
    initial={{opacity:0, scale:.95}} 
    animate={{opacity:1, scale:1}}
    whileHover={{scale:1.05}}
    transition={{duration:0.1, type:'spring', stiffness:100, damping:25, ease:'smooth'}} 

    className='w-full aspect-[4/3] flex flex-col-reverse inset-shadow-black shadow-2xl bg-white text-center m-10 rounded-3xl'

    client:load>
    <div class='relative w-full h-1/2 flex flex-col justify-center bg-[#EEE] rounded-b-3xl'>
      <h1 class='text-3xl'>{name}</h1>
      <h2 class='text-2xl'>{location}</h2>
    </div>
    <div class='w-full h-full flex flex-col justify-start items-center rounded-t-3xl'>
      <img class='mt-10 w-[100px] h-[100px] rounded-[100%] bg-white ring-[5px] ring-blue-50 ring-offset-white ring-offset-[5px]' />
      <h2 class='mt-10 text-2xl'>A chapter with hella goons</h2>

    </div>
  </motion.div>
</a>
