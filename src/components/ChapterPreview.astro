---
import '../styles/global.css';

import { motion } from 'framer-motion';

const  {name, location, image, page  }= Astro.props;


---

<a href={page} class='flex justify-center min-w-[400px] min-h-[480px]  '>
  <motion.div 
    initial={{opacity:0, scale:.95}} 
    whileInView={{opacity:1, scale:1}}
    whileHover={{scale:1.05}}
    transition={{duration:0.3, ease:'easeInOut'}} 

    className=`min-w-[300px] min-h-[360px] sm:w-[350px] sm:h-[410px] flex flex-col-reverse shadow-sombra shadow-2xl  text-center m-10 rounded-3xl`
    client:load>
    <div class='relative w-full h-1/2 flex flex-col justify-center bg-[#EEE] rounded-b-3xl border-t-8 border-t-green-300'>
      <h1 class='text-3xl'>{name}</h1>
      <h2 class='text-xl font-inter'>{location}</h2>
    </div>
    <div class='w-full h-full flex flex-col bg-white justify-start items-center rounded-t-3xl'>
      <img src={image} class=`mt-10 w-[100px] h-[100px] rounded-[100%] ring-[5px] ring-green-300 ring-offset-white ring-offset-[5px]` />
      <h2 class='mt-10 text-xl font-inter'>A chapter with hella goons</h2>

    </div>
  </motion.div>
</a>
