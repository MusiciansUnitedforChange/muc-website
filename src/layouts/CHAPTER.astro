---
import '../styles/global.css';
import Frame from '../layouts/FRAME.astro';
import ChapterContact from '../components/ChapterContact.jsx';

import {motion} from 'framer-motion';

const {name, email, calendar } = Astro.props;

---

<Frame>
  <div class='w-screen h-screen overflow-scroll overflow-x-hidden'>
    <!--Header-->
    <div class=` mt-20 w-full h-1/3 flex flex-col justify-center items-center text-center`>
      <h1 class=`text-2xl md:text-3xl lg:text-4xl border-b-4 m-5 border-green-300 w-auto `>Fund the Future @ {name}</h1>
      <h2 class='text-xl md:text-2xl lg:text-3xl font-inter font-thin'>A collection of dedicated members</h2>
    </div>
  <!--Board-->
    <div class=` dots mt-10 w-full h-auto`>
      <div class='bg-white p-8 mb-10 mx-auto min-w-[300px] w-1/2 flex flex-col items-center text-center shadow-[rgba(0,0,0,0.7)] shadow-2xl rounded-3xl' >
        <h1 class='text-2xl md:text-3xl lg:text-4xl p-5 pb-0 border-b-4 md:border-b-[6px] w-auto border-green-300'>Meet the Board</h1>
        <h2 class='font-inter p-5 text-md md:text-lg lg:text-xl'>Each chapter chooses their board members through a highly-selective process ensuring the best possible candidates for the job.</h2>
      </div>
      <slot name="board-members"/>
    </div>
  <!--Calendar-->
    <div class='w-full h-auto flex flex-col items-center '>
      <h1 class='text-4xl p-10 text-center'>Upcoming Meetings</h1>
      <iframe src={calendar} class='w-[350px] md:w-[700px] lg:w-[1000px] h-[400px] md:h-[700px] lg:h-[1000px]  shadow-2xl shadow-sombra rounded-3xl p-3 md:p-5 mb-20'></iframe>
    </div>

    <ChapterContact name={name} client:load/>
  </div>

</Frame>

