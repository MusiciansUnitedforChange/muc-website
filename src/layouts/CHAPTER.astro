---
import '../styles/global.css';
import Frame from '../layouts/FRAME.astro';
import ChapterContact from '../components/ChapterContact.jsx';

import {motion} from 'framer-motion';

const {name, email, calendar } = Astro.props;

---

<Frame>

  <div class='w-screen h-screen'>
    <div class=` mt-10 w-full h-1/3 flex flex-col justify-center items-center`>
      <h1 class=`text-5xl border-b-8 mb-5 border-green-400 `>Fund the Future @ {name}</h1>
      <h2 class='text-2xl font-inter font-thin'>A collection of dedicated members</h2>
    </div>

    <div class=`dots mt-10 w-full h-auto `>
      <h1 class='text-4xl p-10 '>Meet the Board</h1>
      <slot name="board-members"/>
    </div>

    <div class='w-full h-auto flex flex-col items-center '>
      <h1 class='text-4xl p-10 text-center'>Upcoming Meetings</h1>
      <iframe src={calendar} class='w-[1200px] aspect-[4/3] shadow-2xl shadow-black rounded-3xl p-10 mb-20'></iframe>
    </div>
    <ChapterContact name={name} client:load/>
  </div>

</Frame>

