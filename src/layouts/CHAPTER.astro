---
import '../styles/global.css';
import Frame from '../layouts/FRAME.astro';

import {motion} from 'framer-motion';

const {name } = Astro.props;

---

<Frame>
  <div class='w-screen h-screen'>
    <div class=` mt-10 w-full h-1/3 flex justify-center items-center`>
      <h1 class=`text-5xl border-b-8 border-green-400 `>Fund the Future @ {name}</h1>
    </div>
    <div class=`mt-10 w-full h-auto `>
      <h1 class='text-4xl p-10 '>Meet the Board</h1>
      <slot name="board-members"/>
    </div>
    <div class='w-full h-full'>
      <h1 class='text-4xl p-10 text-center'>Upcoming Meetings</h1>
    </div>
      
  </div>

</Frame>

