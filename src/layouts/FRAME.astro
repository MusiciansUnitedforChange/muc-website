---

import Header from '../components/Header.astro';

const { title } = Astro.props;

---

<html>
  <head>
    <meta charset="utf8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ title }</title>
  </head>
  <body class='flex font-lexend flex-col'>
    <Header></Header>
    <main class='flex-1 w-full h-full lg:overflow-x-hidden md:overflow-x-scroll sm:overflow-x-scroll'>
      <slot/>
    </main>  
  </body>
</html>
