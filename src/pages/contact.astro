---
import '../styles/global.css';

import Frame from '../layouts/FRAME.astro';

import {Instagram, Facebook, Twitter} from 'lucide-react';

import { motion } from 'framer-motion';
---

<Frame>
  <div class='bg-[#3d4240] overflow-x-hidden p-5 md:p-10 lg:p-20 py-auto w-screen h-auto min-h-screen flex flex-col md:flex-row items-center md:items-end justify-center gap-10'>
    <div class='flex flex-col mt-40 lg:mt-0 w-[350px] md:w-[500px] lg:w-[700px] h-auto shadow-2xl shadow-sombra bg-white p-10 rounded-3xl'>

      <h2 class='text-5xl'>Reach Out To Us</h2>
      <h3 class='text-lg font-inter my-5'>Have any questions for our organization? Send us a message, and we will do our best to respond to you within 1-5 business days.</h3>
      <form class='flex flex-col'>
        <label htmlFor='name' className=""
        >Name</label>
        <input class="font-inter w-full border-b-2 h-10 border-b-black outline-none mb-5 focus:border-b-green-300 " id='name' type='text' required/>

        <label htmlFor='email' className=""
        >Email</label>
        <input class="font-inter w-full border-b-2 h-10 border-b-black outline-none mb-5 focus:border-b-green-300" id='email' type='email' required/>

        <label htmlFor='message' className=""
        >How can we help?</label>
        <textarea class="font-inter w-full h-[150px] lg:h-[250px] border-b-2 border-b-black outline-none mb-5 focus:border-b-green-300" id='message' required></textarea>

        <button class='w-full h-[50px] bg-green-300 text-white rounded-3xl mx-auto transition duration-300 ease-in-out hover:bg-green-400 hover:scale-[102%]'>Submit</button>

      </form>
      
    </div>

    <div class='w-[350px] md:w-[600px] lg:w-[800px] flex flex-col gap-10'>
      <div class='w-full hidden h-[300px] md:flex items-center justify-center'>
        <h1 class='text-6xl text-center text-white border-b-[6px] border-b-green-300 w-auto'>We're Here to Help.</h1>
      </div>

      <!--ICONS-->
      <div class='w-full min-h-[250px] h-auto bg-white rounded-3xl shadow-2xl shadow-sombra p-8 flex flex-col gap-3'>

       <a href='/' class='flex items-center p-5 gap-10 bg-[#f5f5f5] transition duration-300 hover:bg-[#EEE] hover:scale-[102%] focus:scale-[99%] rounded-3xl'>
          <Instagram className=' w-[48px] h-[48px] text-green-400'/>
          <div class='flex flex-col '>
            <h2 class="font-lexend text-xl">Instagram</h2>
            <h3 class='font-inter text-lg'>@Handle</h3>
          </div>

        </a>


       <a href='/' class='flex items-center p-5 gap-10 bg-[#f5f5f5] transition duration-300 hover:bg-[#EEE] hover:scale-[102%] focus:scale-[99%] rounded-3xl'>
          <Facebook className=' w-[48px] h-[48px] text-green-400'/>
          <div class='flex flex-col '>
            <h2 class="font-lexend text-xl">Facebook</h2>
            <h3 class='font-inter text-lg'>@Handle</h3>
          </div>

        </a>


       <a href='/' class='flex items-center p-5 gap-10 bg-[#f5f5f5] transition duration-300 hover:bg-[#EEE] hover:scale-[102%] focus:scale-[99%] rounded-3xl'>
          <Twitter className=' w-[48px] h-[48px] text-green-400'/>
          <div class='flex flex-col '>
            <h2 class="font-lexend text-xl">Twitter</h2>
            <h3 class='font-inter text-lg'>@Handle</h3>
          </div>

        </a>


      </div>
    </div>
    

  </div>
</Frame>
