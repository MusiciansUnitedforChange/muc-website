---
import '../styles/global.css';

import Frame from '../layouts/frame.astro';

import MemberDialog from '../components/memberDialog.tsx';

import { motion } from 'framer-motion';

import Eric from '../components/members/eric.md?raw';

---

<Frame>

    <!--Header -->
    <motion.div 
        initial={{opacity:0, y:-30}}
        animate={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
        className="w-full h-[256px] flex flex-col items-center justify-center gap-y-8 py-8">

        <h1 class='w-3/4 text-[1.8rem] font-bold text-center'>Meet the talented team who make all this happen</h1>
        <p ="text-right text-sm text-neutral-800"> some subtext here maybe.....</p>


    </motion.div>

    <div class="w-full flex justify-center">
        <MemberDialog name='Eric Kim' role='President' description={Eric} previewimg='https://broomfieldsymphony.org/wp-content/uploads/2022/03/broomfield-symphony-youth-concerto-winner-eric-kim.jpg' previewalt='Image of Eric Kim' client:load/>

    </div>
    


</Frame>


