---
import '../styles/global.css';
import Frame from '../layouts/FRAME.astro';
import ChapterPreview from '../components/ChapterPreview.astro';

import { motion } from 'framer-motion';
---

<Frame>
  <!--Header-->
  <div class='w-screen h-1/3 md:h-1/2 p-20 text-center flex flex-col items-center'>
    <h1 class='text-4xl lg:text-5xl  mt-20 border-b-[6px] lg:border-b-8 border-b-green-300 w-auto'>Learn About Our Chapters</h1>
    <h2 class='text-xl font-inter mt-5'>yap yap yap we have xx chapters yap yap yap hella members yap yap</h2>
  </div>  
  <!--ChapterPreview collection-->
  <div class='dots w-screen h-full flex flex-wrap justify-center items-center  '>
    <ChapterPreview name='Cherry Creek' location="Greenwood Village, CO", page='/chapters/cherry-creek', image='/icons/schools/Cherry_Creek_HS_logo.png'></ChapterPreview>
    <ChapterPreview name='Grandview' location='Aurora, CO', ></ChapterPreview>
    <ChapterPreview name='...' location='...'></ChapterPreview>
    <ChapterPreview name='...' location='...'></ChapterPreview>
    <ChapterPreview name='...' location='...'></ChapterPreview>
    <ChapterPreview name='...' location='...'></ChapterPreview>
  </div>
</Frame>

