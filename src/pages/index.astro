---
import '../styles/global.css';

import Frame from '../layouts/FRAME.astro';
import ImageSlider from '../components/ImageSlider/ImageSlider.astro';

import {motion} from 'framer-motion';

---

<Frame>
  <!--title image-->
  <div class=' mx-auto my-10 blob flex flex-col justify-center items-center w-full md:max-lg:w-3/4 h-screen'>
    <h1 class='bg-white w-auto text-center border-green-300 border-b-4 md:border-b-[6px] lg:border-b-8 text-4xl sm:text-5xl md:text-6xl lg:text-8xl md:p-2'>Fund The Future</h1>
    <h2 class='text-center font-inter font-thin text-xl md:text-2xl lg:text-3xl p-1 md:p-3'>Because it won't fund itself</h2>
  </div>
  <!--About us-->

  <div class=' dots flex p-5 md:p-10 flex-col lg:flex-row justify-around lg:justify-between w-full h-full'>
    <div class=' w-full lg:w-1/2 h-full text-center lg:text-left'>
      <h1 class='w-auto p-5 text-5xl md:text-6xl bg-white border-b-8 border-b-green-300'> About Us:</h1>
      <h2 class='mt-10 p-5 text-xl md:text-2xl bg-white font-inter'>Fund the Future is a certified 501c3 non-profit organization founded in Colorado when the issue of club funding arose... </h2>
    </div> 
  <!--Image collage-->

    <div class='p-10 w-1/2 h-full'>
      <h2> *insert layered photos* </h2>
    </div>  

  <!--Impact Stories carousel -->
  </div>
  <div class='w-full h-full bg-white flex flex-col items-center'>
    <h1 class='text-6xl mb-5 '>Our Impact</h1>
    <h2 class='text-3xl '>Learn about how we fund shi</h2>
    <ImageSlider></ImageSlider>
  </div>


 
</Frame>
