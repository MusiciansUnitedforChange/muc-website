---
import '../styles/global.css'; 

import Frame from '../layouts/frame.astro'
import { BentoCard, BentoGrid } from '../components/magicui/bento-grid.tsx'

import { Piano, List, Calendar } from 'lucide-react'


---


<Frame>
   
    <!-- Hero Section -->
    <div id="hero" class="p-8 w-full">

        <h1 class="text-xl font-bold w-3/4">Musicians United for Change</h1>
        <h2 class="text-lg p-4 ">Kids changing communities with music.</h2>
    
    </div>

    <!-- Bento Nav section -->
     <div id="nav">

        <BentoGrid className='p-8'>
            <!--About -->
            <BentoCard 
                name="About Us"
                className="col-start-1 col-span-2 h-[256px]"
                bgImage='/images/filler.png'
                Icon={ Piano }
                description="Our goals for MUC"
                href="/about"
                cta="View page"
                />
            
            <div class="col-start-3 col-span-1 h-[256px]">
                <div class="h-full bg-neutral-300"></div>    
            </div>

            <!--Programs -->
            <BentoCard 
                name="Programs"
                className="row-start-2 col-start-2 col-span-2 h-[256px]"
                bgImage='/images/filler.png'
                Icon={ List }
                description="How we engage"
                href="/programs"
                cta="See our programs"
                />
         

            <div class="row-start-2 col-start-1 col-span-1 h-[256px]">
                <div class="h-full bg-neutral-300"></div>    
            </div>

        </BentoGrid>

        


     </div>


    
</Frame>
