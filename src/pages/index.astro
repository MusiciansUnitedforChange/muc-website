---
import '../styles/global.css'; 

import Frame from '../layouts/frame.astro'
import { BentoCard, BentoGrid } from '../components/magicui/bento-grid.tsx'
import { Button } from '@/components/ui/button.tsx';

import { Piano, List, Calendar, Users } from 'lucide-react'


---


<Frame>

    <!--Hero -->

    <div class = 'w-full flex flex-row justify-center'>

            <div class="w-full h-[400px] flex flex-col justify-around items-center p-2 text-center bg-transparent">
                <div class='flex flex-col items-center gap-y-4'>
                    <h1 class="text-[2.2rem] font-bold text-neutral-900">Transforming Lives with Music</h1>
                    <h2 class=" w-[256px] text-[1 rem] text-neutral-800">We bring artists and communities together to raise funds, hope, and awareness—one concert at a time.</h2>
                </div>

                <div class="flex flex-col w-full h-[80px] justify-between items-center ">
                    <Button className='w-[280px] h-[36px] rounded-3xl bg-neutral-900 ring-2 ring-neutral-900 font-bold' client:load>
                        Join Us
                    </Button>
                </div>
                
            
            </div>
    </div>



    <!-- Bento Nav section -->
     <div id="nav">

        <BentoGrid className='p-8'>
            <!--About -->
            <BentoCard 
                name="About Us"
                className="col-start-1 col-span-3 h-[256px]"
                bgImage='/images/filler.png'
                Icon={ Piano }
                description="Our goals for MUC"
                href="/about"
                cta="View page"
                />
            

            <!--Programs -->
            <BentoCard 
                name="Programs"
                className="row-start-2 col-start-1 col-span-3 h-[256px]"
                bgImage='/images/filler.png'
                Icon={ List }
                description="How we engage"
                href="/programs"
                cta="See our programs"
                />
         

            <!--Our Team -->
            <BentoCard 
                name="Our Team"
                className="row-start-3 col-start-1 col-span-3 h-[256px]"
                bgImage='/images/filler.png'
                Icon={ Users }
                description="..."
                href="/board"
                cta="Who makes MUC run?"
                />
        </BentoGrid>

        


     </div>


    
</Frame>
