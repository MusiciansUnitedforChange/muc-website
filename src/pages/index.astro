---
import '../styles/global.css';

import Frame from '../layouts/FRAME.astro';
import ImageSlider from '../components/ImageSlider/ImageSlider.astro';

import {motion} from 'framer-motion';

---

<Frame>
  <div class='w-screen h-screen '>
    <div class='p-20 blob w-full h-3/4 flex flex-col justify-center items-center  '>
      <h1 class='text-9xl bg-white w-auto p-5 text-center border-b-8 border-green-300'>Fund The Future</h1>
      <h2 class='text-3xl p-5 text-center font-inter font-thin'>Because it won't fund itself</h2>
    </div>

    <div class='dots flex justify-between w-full h-full'>
      <div class='p-10 w-1/2 h-full'>
        <h1 class='w-auto p-5 text-6xl bg-white border-b-8 border-b-green-300'> About Us:</h1>
        <h2 class='mt-10 p-5 text-2xl bg-white font-inter'>Fund the Future is a certified 501c3 non-profit organization founded in Colorado when the issue of club funding arose... </h2>
      </div>  
      <div class='p-10 w-1/2 h-full'>
        <h2> *insert layered photos* </h2>
      </div>  

    </div>
    <div class='w-full h-full bg-white flex flex-col items-center'>
      <h1 class='text-6xl mb-5 '>Our Impact</h1>
      <h2 class='text-3xl '>Learn about how we fund shi</h2>
      <ImageSlider></ImageSlider>
    </div>
  </div>


 
</Frame>
