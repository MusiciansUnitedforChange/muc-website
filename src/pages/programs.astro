---
import '../styles/global.css';

import Frame from '../layouts/frame.astro';

---

<Frame>

    <!--Header -->
    <div class="bg-[url(/images/filler.png)] text-white p-2 pb-12 w-full h-[24rem] flex flex-col items-center justify-end">
        
        <div class="flex flex-row justify-between items-center">
            
            <h2 class='p-2 text-[1.8rem] w-1/2'>How we engage our community</h2>

        </div>
        
        <h1 class="text-[2.8rem] font-bold ">Our Programs</h1>


    </div>

    <!--Concerts -->
    <div class="w-full text-left mt-[-24px] bg-neutral-200 p-8 rounded-t-3xl">
        <h1 class='text-xl font-bold'>Concerts</h1>
        <div class="p-4">

            <p>During COVID, MUC organized two virtual benefit concerts for the Food Bank of the Rockies.</p>

        </div>
        
    </div>

    <!--Education -->
    <div class="w-full text-right mt-[-24px] bg-neutral-300 p-8 rounded-t-3xl">
        <h1 class='text-xl font-bold'>Education</h1>
        
        <div class="p-4">
            <p>Our education program provides opportunities for high school musicians to share their love of music while giving back.</p>

        </div>
    </div>


</Frame>