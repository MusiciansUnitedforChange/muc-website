---
import '../styles/global.css';

import Frame from '../layouts/frame.astro';

import { ConcertsPie } from '../components/ui/pie-chart';
import { Marquee } from '@/components/magicui/marquee';
import ImpactDialog from '@/components/impactdialog';

import { motion } from 'framer-motion';

import TemplateContent from '@/components/impacts/template.md?raw';

---

<Frame>

    <!--Header -->
    <motion.div
        initial={{opacity:0, y:-30}}
        animate={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
    
        className="bg-transparent p-2 pb-12 w-full h-[24rem] text-center flex flex-col items-center justify-end">
        
        <div class="flex flex-row justify-center items-center w-[480px]">
            
            <h2 class='p-2 text-neutral-800 text-[18px] md:text-[24px] lg:text-[30px] w-1/2 lg:w-[360px]'>How we engage our community</h2>

        </div>
        
        <h1 class="text-[44px] md:text-[64px] lg:text-[96px] text-neutral-900 font-bold ">Our Programs</h1>


    </motion.div>

    <!--Concerts -->
    <motion.div 
        initial={{opacity:0, y:-20}}
        whileInView={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
        className="w-full text-left mt-[-24px] bg-white/20 p-8 md:p-12 lg:p-16 rounded-t-3xl">
        <h1 class='text-xl md:text-[30px] lg:text-[36px] font-bold'>Concerts</h1>
        <div class="p-4 md:text-[20px] lg:text-[24px] flex justify-between">

            <div class="w-3/4 text-left ">
                <p>We bring live music directly into the community, with regular performances at senior living residences and local venues. In each performance, we strive to foster a space of vulnerability and connection, where music becomes more than sound, but rather a shared experience of hope and humanity. </p>
            </div>

            <!--Stats -->
            <div class="flex-col justify-center items-center w-1/4 hidden">
                <ConcertsPie className='bg-transparent w-[300px] h-[300px] border-none shadow-none' client:load/>
                <ConcertsPie className='bg-transparent w-[300px] h-[300px] border-none shadow-none' client:load/>
            </div>

        </div>
        
    </motion.div>

    <!--Education -->
    <motion.div 
        initial={{opacity:0, y:-20}}
        whileInView={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
    
        className="w-full text-right mt-[-24px] bg-white/20 p-8 md:p-12 lg:p-16 rounded-t-3xl">
        <h1 class='text-xl md:text-[30px] lg:text-[36px] font-bold'>Education</h1>
        
        <div class="p-4 md:text-[20px] lg:text-[24px] text-right">
            <p>Beyond performance, we’re committed to nurturing the next generation of musicians. Our music education program offers mentorship and support for young students, giving them the tools to grow both as artists and as leaders. By encouraging creativity and collaboration, we strive to ensure that the spirit of music continues to inspire for years to come.</p>
            
        </div>
    </motion.div>

    <!--IG Marquee -->
        <motion.div 
        initial={{opacity:0, y:-20}}
        whileInView={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
    
        className="w-full text-center mt-[-24px] bg-white/20 rounded-t-3xl ">
        <h1 class='text-xl md:text-[30px] lg:text-[36px] p-8 md:p-12 lg:p-16 font-bold !pb-6'>Our Impact</h1>
        
        <div class="p-4 pt-0 md:text-[20px] lg:text-[24px] ">
            <p>Take a look and see what we have accomplished so far.</p>
        </div>

        <!--Marquee -->
        <Marquee className='py-4 p-none lg:py-8 w-full !overflow-x-hidden'>
            <ImpactDialog event='First Musicians United for Change Young Artists Benefit Concert' date='04/01/2021' previewimg='https://raw.githubusercontent.com/shinecoop/muc-public/master/public/images/EventImages/BenefitConcert.png' previewalt='Image of MUC event at ... ' description={TemplateContent} client:load/>
            <ImpactDialog event='Kavod Concert + CPR News Feature' date='12/11/2023' previewimg='https://raw.githubusercontent.com/shinecoop/muc-public/master/public/images/EventImages/IMG_4301.jpg' previewalt='Image of MUC event at ... ' description={TemplateContent} client:load/>
            <ImpactDialog event='Concert at the Inn at Greenwood Village' date='08/23/2025' previewimg='https://raw.githubusercontent.com/shinecoop/muc-public/master/public/images/EventImages/IMG_2437.jpg' previewalt='Image of MUC event at ... ' description={TemplateContent} client:load/>
            <ImpactDialog event='MUC Reunion!' date='08/30/2025' previewimg='https://raw.githubusercontent.com/shinecoop/muc-public/master/public/images/EventImages/IMG_1334.jpg' previewalt='Image of MUC event at ... ' description={TemplateContent} client:load/>
        </Marquee>

    </motion.div>



</Frame>