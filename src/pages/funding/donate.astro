---
import '../../styles/global.css';
import Frame from '../../layouts/FRAME.astro';

import {motion} from 'framer-motion';
---

<Frame>
  <div class='w-full h-auto bg-[#3d4240] overflow-x-hidden pb-5'>
    <div class='w-full h-full justify-center'>
      <!--Header-->
      <div class='w-full h-auto mt-20 flex flex-col lg:flex-row bg-[#3d4240] items-center lg:items-start'>
        <div class='min-w-[300px] w-1/2 lg:mt-[200px] h-full text-center text-white flex flex-col justify-center items-center'>
          <h1 class='m-20 mb-0 w-auto text-6xl md:text-7xl border-b-8 border-b-green-300'>Send a Donation</h1>
          <h2 class='font-inter font-thin text-xl text-white mt-5 w-3/4'>Please give us money.</h2>
        </div>

    <!--Form begins-->
        <form action="https://formsubmit.co/johndendrick0@gmail.com" method="POST" class='mx-auto mb-[200px] lg:mb-10 lg:mr-20  w-[400px] md:w-[700px] lg:w-[800px] h-auto overflow-y-scroll overflow-x-hidden bg-white font-inter font-bold p-10 mt-[100px] lg:mt-20 rounded-3xl shadow-[0_50px_50px_8px] shadow-black flex flex-col gap-4'>
          <p>Fields marked with * are required</p>
          <h1 class = 'text-3xl'>Personal Information</h1>
<!-- names --> 
          <div class="flex gap-4">
            <div class="flex flex-col flex-auto">
              <label for='fname'>First Name*</label>
              <input type='text' id='fname' name='First Name' placeholder="John" required>
            </div>
            <div class="flex flex-col flex-auto">
              <label for='lname'>Last Name*</label>
              <input type='text' id='lname' name='Last Name' placeholder="Doe" required>
            </div>
          </div>
<!-- email -->
          <div class="flex flex-col">
            <label for='email'>Email Address*</label>
            <input type='email' id='email' name='email' placeholder="user@email.com" required>
          </div>

<!-- Message -->
          <div class = 'flex flex-col'>
            <label for = "Purpose">Message</label>
            <textarea id = 'Purpose' name = "Purpose" placeholder="Share why you're making this donation."></textarea>
          </div>
          <div class = 'flex flex-col'>
<!-- SUBMIT!!!! -->
            <button type ='submit' class = "bg-green-300 text-white text-xl mx-auto mt-5 p-3 rounded-3xl w-full transition duration-300 ease-in-out hover:scale-[102%] hover:bg-green-400" >Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>


</Frame>


<style> 
  textarea{
    width: 100%;
    height: 200px;
    padding: 5px;
    border: 2px solid gray;
    border-radius: 4px;
    resize: none;

    font-weight:100;
  }
  input{
    width: 100%;
    height: 50px;
    padding: 5px;
    border: 2px solid gray;
    border-radius: 4px;
    resize: none;

    font-weight:100; 
  }

  select{
    
    font-weight:100;
  }

  label{
    
    font-size:15px;

  }


</style>
