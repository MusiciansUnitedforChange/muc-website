---
import '../../styles/global.css';
import Frame from '../../layouts/FRAME.astro';

import {motion} from 'framer-motion';
---

<Frame>
  <div class='w-full h-auto bg-[#3d4240] overflow-x-hidden pb-5'>
    <div class='w-full h-full justify-center'>
      <!--Header-->
      <div class='w-full h-auto mt-20 flex flex-col lg:flex-row bg-[#3d4240] items-center lg:items-start'>
        <div class='min-w-[300px] w-1/2 lg:mt-[200px] h-full text-center text-white flex flex-col justify-center items-center'>
          <h1 class='m-20 mb-0 w-auto text-6xl md:text-7xl border-b-8 border-b-green-300'>Apply for a Grant</h1>
          <h2 class='font-inter font-thin text-xl text-white mt-5 w-3/4'>It is our goal to make the funding process as simple and accessible as possible, so your ideas are not fettered by the chains of financial burden.</h2>
        </div>

    <!--Form begins-->
        <form action="https://formsubmit.co/johndendrick0@gmail.com" method="POST" class='mx-auto mb-[200px] lg:mb-10 lg:mr-5 xl:mr-20 w-[400px] md:w-[700px] lg:w-[800px] h-auto overflow-y-scroll overflow-x-hidden bg-white font-inter font-bold p-10 mt-[100px] lg:mt-20 rounded-3xl shadow-[0_50px_50px_8px] shadow-sombra flex flex-col gap-4 '>
          <p>Fields marked with * are required</p>
          <h1 class = 'text-3xl'>Personal Information</h1>
<!-- names --> 
          <div class="flex gap-4">
            <div class="flex flex-col flex-auto">
              <label for='fname'>First Name*</label>
              <input type='text' id='fname' name='First Name' placeholder="John" required>
            </div>
            <div class="flex flex-col flex-auto">
              <label for='lname'>Last Name*</label>
              <input type='text' id='lname' name='Last Name' placeholder="Doe" required>
            </div>
          </div>
<!-- email -->
          <div class="flex flex-col">
            <label for='email'>Email Address*</label>
            <input type='email' id='email' name='email' placeholder="user@email.com" required>
          </div>
<!--School name + grades -->
          <div class = "flex gap-4">
            <div class = 'flex flex-col flex-[4]'>
              <label for='schoolname'>School Name*</label>
              <input type ='text' id = 'schoolName' name = 'schoolname' placeholder = "University High School" required>
            </div>
            <div class = 'flex flex-col flex-[1]'>
              <label for ='grade'>Grade*</label>
              <select id="grade" name="grade" class="h-[50px] border-2 bg-white border-gray-500 p-3 rounded-md w-full text-gray-400" 
                onchange= "this.classList.remove('text-gray-400'); this.classList.add('text-black');">
                <option value ="" disabled selected>Choose Grade</option>
                <option value="9th"  class = "text-gray-900">9th</option>
                <option value="10th" class = "text-gray-900">10th</option>
                <option value="11th" class = "text-gray-900">11th</option>
                <option value="12th" class = "text-gray-900">12th</option>
              </select>
            </div>
          </div>
<!-- Grant Details begin -->
          <h1 class = 'text-3xl'>Grant Details</h1>
<!-- ClubName + Amount requested -->
          <div class = 'flex gap-4 items-end'>
            <div class = 'flex flex-col flex-[3]'>
              <label for = 'ClubName'>Club or Program Name*</label>
              <input type="text" id="ClubName" name = "ClubName" placeholder = "What is the name of your club or program?" required>
            </div>
            <div class = 'flex flex-col flex-[1]'>
              <label for = 'Money'>Amount Requested ($)*</label>
              <input type = 'number' id = 'Money' name = 'Money' placeholder ="0.00" required>
            </div>
          </div>
<!-- Purpose -->
          <div class = 'flex flex-col'>
            <label for = "Purpose">Purpose of Funding*</label>
            <textarea id = 'Purpose' name = "Purpose" placeholder="Please describe what you will use the grant to achieve."></textarea>
          </div>
          <div class = 'flex flex-col'>
<!-- SUBMIT!!!! -->
            <button type ='submit' class = "bg-green-300 text-white text-xl mx-auto mt-5 p-3 rounded-3xl w-full transition duration-300 ease-in-out hover:scale-[102%] hover:bg-green-400" >Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>


</Frame>


<style> 
  textarea{
    width: 100%;
    height: 200px;
    padding: 5px;
    border: 2px solid gray;
    border-radius: 4px;
    resize: none;

    font-weight:100;
  }
  input{
    width: 100%;
    height: 50px;
    padding: 5px;
    border: 2px solid gray;
    border-radius: 4px;
    resize: none;

    font-weight:100; 
  }

  input:focus, textarea:focus, select:focus{
    outline-color:lime;

  }

  select{
    
    font-weight:100;
  }

  label{
    
    font-size:15px;

  }


</style>
