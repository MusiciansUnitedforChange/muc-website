---
import '../styles/global.css';

import Frame from '../layouts/frame.astro';
import { Marquee } from '../components/magicui/marquee.tsx';

import { ArrowRight } from 'lucide-react';

---

<Frame>

    <!--Header -->
    <div class="bg-[url(/images/filler.png)] text-white p-2 pb-12 w-full h-[24rem] flex flex-col items-center justify-end">
        
        <div class="flex flex-row justify-end items-center">
            
            <h2 class='p-2 text-[1.2rem] w-1/2'>What a little bit of music can do for a young mind</h2>

        </div>
        
        <h1 class="text-[4rem] font-bold ">About Us</h1>


    </div>

    <!--About -->

    <div class="relative w-full p-8 bg-neutral-200 mt-[-24px] flex flex-row justify-between">

        <div class="z-10 sticky self-start top-0 flex flex-col items-center p-2 w-1/5 ">
            <h1 class="text-xl font-bold"> Our Story</h1>
            <ArrowRight size={36}/>
        </div>

        <div class="w-3/5">
            <p class="text-md  text-neutral-800 "> Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills.Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills. Musicians United for Change found its roots in talented individuals sharing their skills.</p>
        </div>
        
    </div>

    <!--Mission-->

    <div class="w-full p-8 bg-neutral-300 text-center">

        <h1 class='text-3xl'>Our <span class="font-bold">Mission</span></h1>
        <p class="text-md py-4">At MUC we strive to inspire solidarity, transcend demographics, and spread joy through the universal language of music.</p>

    </div>

    <!--Marquee -->

    <div class="p-none">
        <Marquee reverse className='[--duration:80s] sm:[--duration:100s] '>

        <img class='w-[512px] h-[256px]' src="/images/filler.png">
        <img class='w-[512px] h-[256px]' src="/images/filler.png">
        <img class='w-[512px] h-[256px]' src="/images/filler.png">
        <img class='w-[512px] h-[256px]' src="/images/filler.png">

        </Marquee>

    </div>

    <!--Vision-->

    <div class="w-full p-8 bg-neutral-200 text-center">

        <h1 class='text-3xl'>Our <span class="font-bold">Vision</span></h1>
        <p class="text-md py-4">A nation where every person can experience the music of their choosing and every child believes that they can unite their community.</p>

    </div>

    


</Frame>