---
import '../styles/global.css';

import Frame from '../layouts/frame.astro';
import { Marquee } from '../components/magicui/marquee';

import { ArrowRight } from 'lucide-react';

import { motion } from 'framer-motion';

---

<Frame>

    <!--Header -->
    <motion.div 
        initial={{opacity:0, y:-30}}
        animate={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
        className="bg-transparent overflow-x-hidden p-2 pb-12 w-full h-[24rem] text-center flex flex-col items-center justify-end"
        

        >
        
        <div class="flex flex-row w-[480px] justify-center items-center">
            
            <h2 class='p-2 text-neutral-800 text-[18px] md:text-[24px] lg:text-[30px] w-1/2 md:w-[300px] lg:w-[360px]'>What a little bit of music can do for a young mind</h2>

        </div>
        
        <h1 class="text-[44px] md:text-[64px] lg:text-[96px] text-neutral-900 font-bold ">About Us</h1>


    </motion.div>

    <!--About -->

    <motion.div
        initial={{opacity:0}}
        whileInView={{opacity:1}}
        transition={{duration:1.5, type:'sticky'}}
        client:load
    >
            <div
                class="relative w-full h-auto p-8 bg-transparent mt-[-24px] flex flex-row justify-between lg:justify-around ">

                <div
                    class="z-10 sticky self-start top-0 flex flex-col items-center p-2 w-1/5 ">
                    <h1 
                        
                        class="text-xl md:text-[24px] lg:text-[36px] font-bold pb-4 leading-[40px] itext-center"> Our Story</h1>
                    <ArrowRight size={64}/>
                </div>

                <div class="w-3/5">
                    <p class="text-md md:text-[20px] lg:text-[36px]  text-neutral-800 "> Musicians United for Change began in Colorado, when a group of high schoolers hosted a benefit concert during the pandemic. That single online performance raised over 19,500 meals for the Food Bank of the Rockies, showing us the power to inspire and spread hope through music. What started as one event has grown into regular live concerts at senior living communities and a music education program that supports the next generation of musicians. We believe in sharing the universal language of music with all.</p>
                </div>
                
            </div>
    </motion.div>

    <!--Mission-->

    <motion.div 
        initial={{opacity:0, y:-30}}
        whileInView={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
        className="flex justify-center w-full h-[280px] md:h-[360px] lg:h-[580px] items-center bg-white/10">

        <div class="w-[360px] md:w-[420px] lg:w-[560px] aspect-[4/3] bg-white/15 flex justify-center items-center rounded-lg">
            <div class=" flex flex-col justify-around p-4 items-center w-[320px] md:w-[360px] lg:w-[480px] aspect-[4/3] rounded-xl  bg-white/30  text-center">

                <h1 class='text-[44px] lg:text-[64px]'>Our <span class="font-bold">Mission</span></h1>
                <p class="text-md lg:text-[24px] ">At MUC we strive to inspire solidarity, transcend demographics, and spread joy through the universal language of music.</p>

            </div>
        </div>
    </motion.div>



    <!--Vision-->

    <motion.div 
        initial={{opacity:0, y:-30}}
        whileInView={{opacity:1, y:0}}
        transition={{duration:1.5, type:'spring'}}
        client:load
        className="w-full p-8 bg-transparent text-center flex items-center flex-col">

        <h1 class='text-[44px] lg:text-[64px]'>Our <span class="font-bold">Vision</span></h1>
        <p class="text-md lg:text-[24px] p-4 lg:p-8 lg:w-1/2 ">A nation where every person can experience the music of their choosing and every child believes that they can unite their community.</p>

    </motion.div>

    


</Frame>